[Unit]
Description=Reachy Cafe card slot agent
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/kiosk.env
ExecStart=/usr/bin/python3 __DIR__/card_agent.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
