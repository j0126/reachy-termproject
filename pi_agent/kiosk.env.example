# Reachy Café 키오스크(Pi 4) 설정. install_pi.sh가 kiosk.env로 복사한다.
# 두뇌 PC(데스크톱)의 IP. 공유기에서 DHCP 예약으로 고정해 두면 편하다.
# 발표 직전에 핫스팟으로 바꾸면 이 값만 고치고 재부팅한다.
BRAIN_HOST=192.168.0.10
BRAIN_PORT=8000
# 키오스크 페이지가 이 시간(초) 안에 두뇌 PC에 붙지 않으면(흰 화면) Chromium을 다시 띄운다. 기본 60
# KIOSK_PAGE_TIMEOUT=60

# 카드 슬롯 배선 (BCM 번호): 스위치 GPIO17(핀 11) ↔ GND(핀 9), LED GPIO27(핀 13) → 220Ω → GND(핀 14)
CARD_GPIO=17
LED_GPIO=27
